# LLM provider (local, groq, gemini, nvidia)
LLM_PROVIDER=local
LOCAL_LLM_HOST_PATH=C:/Users/.../Documents/models/llm/Qwen2.5-1.5B-Instruct
LOCAL_LLM_MODEL_PATH=/models/llm/Qwen2.5-1.5B-Instruct
LOCAL_LLM_DEVICE=cpu
LOCAL_LLM_MAX_NEW_TOKENS=1024
GROQ_API_KEY=
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=256
RERANKER_DEVICE=auto
RERANKER_USE_FP16=true
RERANKER_LOCAL_FILES_ONLY=false

# Langfuse LLM Observability (Sign up at cloud.langfuse.com or us.cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
